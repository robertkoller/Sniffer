PORT=3001

# Bind address. Leave unset (defaults to 0.0.0.0) for local dev so a phone on the
# LAN can reach your Mac. In production set HOST=127.0.0.1 so the port is only
# reachable by the local reverse proxy (Caddy), never directly over plain HTTP.
# HOST=127.0.0.1

# CORS: the website origin allowed to call the API. Locked to this value unless
# NODE_ENV=development. Set to your deployed web origin in production.
CLIENT_ORIGIN=http://localhost:3000

# Set to "production" on the server. Controls the CORS posture (and, historically,
# dev login — which is now gated on ENABLE_DEV_LOGIN below instead).
# NODE_ENV=production

# Password-less "sign in as any email" dev shortcut. Leave UNSET in production.
# `npm run dev` sets this automatically for local development.
# ENABLE_DEV_LOGIN=true

# Google OAuth (from Google Cloud Console). Required for real sign-in.
# Authorized redirect URI: <SERVER_PUBLIC_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=your_google_web_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# The server's own public URL — used to build the OAuth redirect URI.
# SERVER_PUBLIC_URL=http://localhost:3001

# WHOIS/RDAP domain-age trust scoring (on by default; set to "false" to disable).
# WHOIS_ENABLED=true
